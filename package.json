{
  "name": "uxward-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && find dist -name '.DS_Store' -delete",
    "build:preview": "astro build --config astro.config.preview.mjs && find dist -name '.DS_Store' -delete",
    "preview": "astro preview",
    "astro": "astro",
    "wireframes:png": "for f in D-UX-Design/wireframes/*.excalidraw; do excalidraw-brute-export-cli -i \"$f\" -o \"${f%.excalidraw}.png\" -f png -b true -s 2; done"
  },
  "dependencies": {
    "astro": "^7.1.2",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^8.0.13",
    "nanoid": "^5.1.16",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "svgo": "^4.0.2"
  }
}
