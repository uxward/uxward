---
import Base from '../layouts/Base.astro';
import { slate } from '../data/slate.js';
import { essaysNewestFirst, plainTitle } from '../data/essays.js';
import { build, shortDate, REPO } from '../data/build-info.js';

// Masthead: every cell is derived, so none of them can go quietly stale.
// LAST SHIP looks for the entry that actually has a ship date rather than
// assuming it is the hero of the slate — the hero is Precocity, a ten-year
// engagement with no single ship.
const lastShip = slate.find((c) => c.shipped);
const latestEssay = essaysNewestFirst[0];

// The home rows carry their own shorter decks; imagery comes from the slate,
// which stays the single source of truth for what each case looks like.
const bySlug = Object.fromEntries(slate.map((c) => [c.slug, c]));
const featured = [
  {
    slug: 'precocity',
    name: 'Precocity',
    tag: ' — the ten-year build',
    when: 'CXO · 2016–present',
    desc: "I was Precocity's first UX hire. Ten years later, the practice I built is why the firm wins seven-figure enterprise work. If you read one case study, read this one.",
  },
  {
    slug: 'speakeazy',
    name: 'Speakeazy',
    tag: ' — the tool that should have existed',
    when: 'Founder · 2025–present',
    desc: "An AI tool that does the character prep audiobook narrators don't get paid for. I built it myself, and real narrators have been using it since January 2026.",
  },
  {
    slug: 'autoco',
    name: 'A global automaker',
    tag: ' — testing like an outsider',
    when: 'Director of UX · 2017–2022',
    desc: 'Built and led the independent, bias-free usability practice that the automaker brought in-house: 17 studies, 3,500 hours of testing.',
  },
].map((f) => ({ ...f, preview: bySlug[f.slug].preview }));

const building = [
  {
    name: 'Speakeazy',
    desc: 'Character prep for audiobook narrators, done by AI. Live, with working narrators using it.',
    href: 'https://speakeazy.pro',
  },
  {
    name: 'Design Library Showcase Generator',
    desc: 'A Figma plugin to instantly create a showcase of all library components and their variants.',
    href: 'https://www.figma.com/community/plugin/1355255111922370746/design-library-showcase-generator-by-precocity',
  },
  { name: 'FORGE', desc: 'Feed it content and context, get a built, functioning website: IA, Design System, and code.' },
  { name: 'Verity', desc: "The beginnings of a complete UX research and reporting platform for agencies and enterprises. The most ambitious thing I'm working on." },
  { name: 'RAD', desc: 'A dashboard for running and reporting moderated usability studies.' },
];

const site = import.meta.env.SITE;

// `speakable` points voice and AI surfaces at the two blocks that actually
// state what this site is — the hero headline and its lede — rather than
// letting them pick from the masthead's derived data cells.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "url": site,
      "name": "uxward — Brandon E. B. Ward",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".hero h1", ".hero .lede"]
      },
      "about": { "@type": "Person", "name": "Brandon E. B. Ward", "url": `${site}/about` }
    }
  ]
};
---
<Base title="uxward — Brandon E. B. Ward" description="Brandon E. B. Ward — executive design leader. 20+ years building design practices from scratch. Founder of Speakeazy. CXO at Precocity. Based in Dallas." schema={schema}>

  <style>
    /* ============================================================
       Homepage — the Archivo / Swiss system. Lineage (see colophon):
         · Wim Crouwel — total grid, the page as a system
         · Experimental Jetset — one typeface, used without apology
         · Reid Miles / Blue Note — type + color cropped to the edge
         · Massimo Vignelli — the grid made visible; black, white, one color
       One grotesque (Archivo), exposed rules, big tight display, catalog
       numbers, a full-bleed color field.
       ============================================================ */
    .hero-bg { display: none; }

    .sys {
      font-family: "Archivo", system-ui, -apple-system, "Segoe UI", sans-serif;
      padding-bottom: 0;
      /* Softened rule color so dividers aren't harsh ink in either theme. */
      --alt-rule: color-mix(in srgb, var(--ink) 10%, transparent);
    }
    .sys h1, .sys h2, .sys h3, .sys p { margin: 0; }
    .sys figure { margin: 0; }

    /* ---------- Masthead: a Unigrid spec bar, wired to real data ----------
       Column widths are unequal on purpose: the essay title needs the room,
       "Based" needs almost none. Vignelli's Unigrid allocates columns to
       content, it doesn't divide them evenly. */
    .sys .mast { padding: var(--space-8) 0 0; }
    .sys .spec-bar {
      display: grid;
      grid-template-columns: 1fr 1.5fr 1fr 0.8fr;
      border: 1px solid var(--alt-rule);
    }
    .sys .spec-bar .cell {
      display: flex;
      flex-direction: column;
      padding: var(--space-4) var(--space-5);
      border-left: 1px solid var(--alt-rule);
    }
    .sys .spec-bar .cell:first-child { border-left: 0; }
    .sys .spec-bar .k {
      display: block;
      font-size: var(--fs-11);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--tertiary);
      margin-bottom: 7px;
    }
    .sys .spec-bar .v { font-size: var(--fs-16); font-weight: 700; color: var(--ink); line-height: 1.2; }
    .sys .spec-bar a.v { text-decoration: none; }
    /* Datelines sit on a shared bottom edge across all four cells. */
    .sys .spec-bar .d {
      margin-top: auto;
      padding-top: var(--space-4);
      font-size: var(--fs-11);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--tertiary);
    }

    /* ---------- Hero: the display runs full measure, then the grid splits ---------- */
    .sys .hero { padding: var(--space-9) 0 var(--space-10); }
    .sys .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      column-gap: var(--space-9);
    }
    .sys .hero h1 {
      grid-column: 1 / -1;
      grid-row: 1;
      font-weight: 900;
      font-size: var(--fs-d8);
      line-height: 0.94;
      letter-spacing: -0.045em;
      /* Negative tracking closes word spaces as well as letter spaces; put the
         word space back so display lines don't read as one long word. */
      word-spacing: 0.06em;
      text-wrap: balance;
      color: var(--ink);
      max-width: 15ch;
    }
    .sys .hero .lede {
      grid-column: 1;
      grid-row: 2;
      margin-top: var(--space-8);
      font-size: var(--fs-lede);
      font-weight: 400;
      line-height: 1.45;
      text-wrap: pretty;
      color: var(--body);
      max-width: 58ch;
    }
    .sys .hero .lede a { color: var(--ink); text-underline-offset: 3px; }

    /* The portrait as a catalog plate: a hairline, a specimen caption, and
       nothing else. The site's one photograph, treated like every other
       element in the system. */
    .sys .plate { grid-column: 2; grid-row: 2; margin-top: var(--space-8); }
    .sys .plate img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 5 / 4;
      object-fit: cover;
      border: 1px solid var(--alt-rule);
    }
    .sys .plate figcaption {
      margin-top: var(--space-3);
      font-size: var(--fs-11);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--tertiary);
    }

    /* ---------- Catalog section header (big red number + caps title) ---------- */
    /* Full-bleed section dividers (edge-to-edge); the red field needs none. */
    .sys section { padding: var(--space-9) 0; border-top: 1px solid var(--alt-rule); }
    .sys section.cta { border-top: 0; }
    .sys .sec-head {
      display: flex;
      align-items: flex-end;
      gap: var(--space-5);
      margin-bottom: var(--space-8);
    }
    .sys .sec-head .no {
      font-weight: 900;
      font-size: var(--fs-d6);
      line-height: 0.78;
      letter-spacing: -0.045em;
      color: var(--signature);
    }
    .sys .sec-head .ttl {
      margin: 0;
      font-weight: 700;
      font-size: var(--fs-14);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink);
      padding-bottom: 0.5em;
    }

    /* ---------- Catalog list (work, writing) ---------- */
    .sys .cat .item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-7);
      row-gap: var(--space-3);
      padding: var(--space-6) 0;
      border-top: 1px solid var(--alt-rule);
      align-items: baseline;
    }
    .sys .cat .item:first-child { border-top: 0; }
    .sys .cat a { color: inherit; text-decoration: none; }
    .sys .cat .c-title {
      font-weight: 800;
      font-size: var(--fs-d1);
      line-height: 1.02;
      letter-spacing: -0.022em;
      word-spacing: 0.04em;
      text-wrap: pretty;
      color: var(--ink);
    }
    /* Titular name leads heavy (Archivo 900); the tagline after it sits back. */
    .sys .cat .c-title .n { font-weight: 900; }
    .sys .cat .c-title .t { font-weight: 500; color: var(--body); }
    .sys .cat .c-when {
      font-weight: 600;
      font-size: var(--fs-12);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--tertiary);
      white-space: nowrap;
      text-align: right;
    }
    .sys .cat .c-desc {
      grid-column: 1 / -1;
      font-size: var(--fs-16);
      line-height: 1.5;
      text-wrap: pretty;
      color: var(--body);
      max-width: 66ch;
    }
    .sys .cat .c-desc a { color: var(--ink); }
    .sys .cat .item:focus-visible { outline: 2px solid var(--signature); outline-offset: 4px; }

    /* Slate variant: a real artifact from the case, at index scale. */
    .sys .cat.slate .item { grid-template-columns: 148px minmax(0, 1fr) auto; }
    .sys .cat.slate .c-shot { grid-column: 1; grid-row: 1 / span 2; align-self: start; }
    .sys .cat.slate .c-shot img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border: 1px solid var(--alt-rule);
    }
    .sys .cat.slate .c-title { grid-column: 2; grid-row: 1; }
    .sys .cat.slate .c-when  { grid-column: 3; grid-row: 1; }
    .sys .cat.slate .c-desc  { grid-column: 2 / -1; grid-row: 2; }

    .sys .more {
      display: inline-block;
      margin-top: var(--space-7);
      font-weight: 700;
      font-size: var(--fs-13);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink);
      border-bottom: 2px solid var(--signature);
      padding-bottom: 2px;
    }

    /* Building variant: name / desc / status. Two of these ship; four don't,
       and the difference has to be legible before the cursor arrives. */
    .sys .cat.build .item { grid-template-columns: 250px minmax(0, 1fr) auto; }
    .sys .cat.build .b-name { font-weight: 700; font-size: var(--fs-18); letter-spacing: -0.01em; color: var(--ink); }
    .sys .cat.build .b-ext { font-weight: 400; }
    .sys .cat.build .b-desc { font-size: var(--fs-16); line-height: 1.45; color: var(--body); }
    .sys .cat.build .b-desc a { color: var(--ink); }
    .sys .cat.build .b-status {
      font-weight: 700; font-size: var(--fs-12); text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--tertiary); text-align: right; white-space: nowrap;
    }
    .sys .cat.build .is-live .b-status { color: var(--signature); }
    /* Unlinked rows recede at rest, and never light up. */
    .sys .cat.build .is-private .b-name { font-weight: 600; color: var(--body); }

    /* ---------- About ---------- */
    .sys .about p { font-size: var(--fs-18); line-height: 1.6; text-wrap: pretty; color: var(--body); max-width: 60ch; }
    .sys .about .more { margin-top: var(--space-6); }

    /* ---------- CTA: the bold color field (used, not rationed) ----------
       Everything on the red field runs at full offwhite: #E7E7E7 on #CC0006 is
       4.76:1, so there is no contrast headroom left to spend on opacity. */
    .sys .cta { background: var(--signature-field); padding: var(--space-11) 0; }
    .sys .cta .sec-head { border-top-color: #e7e7e7; }
    .sys .cta .sec-head .no { color: #e7e7e7; }
    .sys .cta .sec-head .ttl { color: #e7e7e7; }
    /* :not(.ttl) — the section label is an h2 too, and must not inherit
       the headline's measure, tracking, or balancing. */
    .sys .cta h2:not(.ttl) {
      font-weight: 900;
      font-size: var(--fs-d6);
      line-height: 0.96;
      letter-spacing: -0.035em;
      word-spacing: 0.06em;
      text-wrap: balance;
      color: #e7e7e7;
      max-width: 17ch;
    }
    .sys .cta .email {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      margin-top: var(--space-8);
      font-weight: 800;
      font-size: var(--fs-d2);
      color: #e7e7e7;
    }
    .sys .cta .email .email-text {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
    .sys .cta .email .send-ico { width: 0.82em; height: 0.82em; }
    .sys .cta .note {
      font-weight: 600; font-size: var(--fs-13); text-transform: uppercase; letter-spacing: 0.05em;
      color: #e7e7e7; margin-top: var(--space-6);
    }

    /* Hover is a pointer affordance; on touch it only leaves stuck states. */
    @media (hover: hover) {
      .sys .cat .item:hover .c-title { color: var(--signature); }
      .sys .cat.build a.item:hover .b-name { color: var(--signature); }
      .sys .more:hover { color: var(--signature); }
      /* The red field has no contrast to give away, so hover thickens the
         rule instead of fading the text. */
      .sys .cta .email:hover .email-text { text-decoration-thickness: 4px; }
    }
    .sys .cta .email:hover .send-icon,
    .sys .cta .email:focus-visible .send-icon { animation: send-fly 0.5s ease; }

    @media (max-width: 900px) {
      .sys .spec-bar { grid-template-columns: 1fr 1fr; }
      .sys .spec-bar .cell:nth-child(3) { border-left: 0; }
      .sys .spec-bar .cell:nth-child(3), .sys .spec-bar .cell:nth-child(4) { border-top: 1px solid var(--alt-rule); }

      /* Headline first (it's the strongest thing on the page), then the face,
         then the lede — so the portrait lands inside the first screen. */
      .sys .hero-grid { grid-template-columns: minmax(0, 1fr); }
      .sys .hero .lede { grid-column: 1; grid-row: 3; margin-top: var(--space-7); }
      .sys .plate { grid-column: 1; grid-row: 2; margin-top: var(--space-7); max-width: 460px; }

      .sys .cat.build .item { grid-template-columns: minmax(0, 1fr); }
      .sys .cat.build .b-status { text-align: left; }
    }

    @media (max-width: 720px) {
      /* The date column was squeezing titles into four and five lines. Give
         it its own row and let the title have the full measure. */
      .sys .cat .item { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
      .sys .cat .c-when { text-align: left; }
      .sys .cat .c-desc { margin-top: var(--space-2); }

      .sys .cat.slate .item { grid-template-columns: 88px minmax(0, 1fr); column-gap: var(--space-5); }
      .sys .cat.slate .c-shot  { grid-column: 1; grid-row: 1 / span 2; }
      .sys .cat.slate .c-title { grid-column: 2; grid-row: 1; }
      .sys .cat.slate .c-when  { grid-column: 2; grid-row: 2; }
      /* The deck takes the full measure rather than the narrow column beside
         the thumbnail — 30 characters a line is not a reading width. */
      .sys .cat.slate .c-desc  { grid-column: 1 / -1; grid-row: 3; }
    }
  </style>

  <div class="sys">
    <!-- Masthead — every cell derived at build time, so none of them can lie. -->
    <div class="mast">
      <div class="container">
        <div class="spec-bar">
          <div class="cell">
            <span class="k">Last ship</span>
            <a class="v" href={`/work/${lastShip.slug}`}>{lastShip.client}</a>
            <span class="d">{shortDate(lastShip.shipped)}</span>
          </div>
          <div class="cell">
            <span class="k">Last essay</span>
            <a class="v" href={`/writing/${latestEssay.slug}`}>{plainTitle(latestEssay.title)}</a>
            <span class="d">{latestEssay.quarter}</span>
          </div>
          <div class="cell">
            <span class="k">Source</span>
            {build
              ? <a class="v" href={`${REPO}/commit/${build.sha}`} target="_blank" rel="noopener">{build.sha}</a>
              : <a class="v" href={REPO} target="_blank" rel="noopener">uxward/uxward</a>}
            {build && <span class="d">{shortDate(build.iso)}</span>}
          </div>
          <div class="cell">
            <span class="k">Based</span>
            <span class="v">Dallas, Texas</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Hero -->
    <div class="hero">
      <!-- Cyber-only animated city backdrop. Source attached lazily by script below. -->
      <div class="hero-bg" aria-hidden="true">
        <video class="hero-bg-video" muted loop playsinline preload="none" data-src="/videos/cybercity-sm.mp4"></video>
      </div>
      <div class="container">
        <div class="hero-grid">
          <h1>I build design practices. Over twenty years' experience. Now I do it with AI.</h1>
          <p class="lede">
            I built and shipped <a href="/work/speakeazy">Speakeazy</a> (real narrators using it since Jan. 2026)
            while running the XD practice at Precocity as CXO. Before that I stood up UX teams at four startups and two agencies.
          </p>
          <figure class="plate">
            <img src="/images/BrandonEBWard-003-full.webp"
                 alt="Brandon E. B. Ward"
                 width="1200" height="946"
                 fetchpriority="high" decoding="async" />
            <figcaption>Fig. 01 — B.E.B.W., Dallas, 2026</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <!-- 01 Work -->
    <section>
      <div class="container">
        <div class="sec-head"><span class="no">01</span><h2 class="ttl">Selected work</h2></div>
        <div class="cat slate">
          {featured.map((f) => (
            <a class="item" href={`/work/${f.slug}`}>
              <span class="c-shot">
                <img src={f.preview.src} alt={f.preview.alt}
                     width={f.preview.width} height={f.preview.height} loading="lazy" decoding="async" />
              </span>
              <h3 class="c-title"><span class="n">{f.name}</span><span class="t">{f.tag}</span></h3>
              <span class="c-when">{f.when}</span>
              <p class="c-desc">{f.desc}</p>
            </a>
          ))}
        </div>
        <a class="more" href="/work">See all {slate.length} pieces</a>
      </div>
    </section>

    <!-- 02 Building -->
    <section>
      <div class="container">
        <div class="sec-head"><span class="no">02</span><h2 class="ttl">Building now</h2></div>
        <div class="cat build">
          {building.map((b) => (
            b.href
              ? <a class="item is-live" href={b.href} target="_blank" rel="noopener">
                  <span class="b-name">{b.name} <span class="b-ext" aria-hidden="true">↗</span></span>
                  <span class="b-desc">{b.desc}</span>
                  <span class="b-status">Live</span>
                </a>
              : <div class="item is-private">
                  <span class="b-name">{b.name}</span>
                  <span class="b-desc">{b.desc}</span>
                  <span class="b-status">Private</span>
                </div>
          ))}
          <div class="item is-private">
            <span class="b-name">Marksman</span>
            <span class="b-desc">An in-house macOS markdown converter, built with <a href="https://github.com/microsoft/markitdown" target="_blank" rel="noopener">Markitdown</a> at Precocity.</span>
            <span class="b-status">Private</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Writing -->
    <section>
      <div class="container">
        <div class="sec-head"><span class="no">03</span><h2 class="ttl">Writing</h2></div>
        <div class="cat">
          {essaysNewestFirst.slice(0, 3).map((e) => (
            <a class="item" href={`/writing/${e.slug}`}>
              <h3 class="c-title" set:html={e.title} />
              <span class="c-when">{e.quarter}</span>
              <p class="c-desc">{e.deck}</p>
            </a>
          ))}
        </div>
        <a class="more" href="/writing">All writing</a>
      </div>
    </section>

    <!-- 04 About -->
    <section class="about-sec">
      <div class="container">
        <div class="sec-head"><span class="no">04</span><h2 class="ttl">About</h2></div>
        <div class="about">
          <p>
            I'm Brandon. I've spent my career building and running design practices: four startups,
            two agencies, a stretch of consulting, and the last ten years at Precocity. Lately I've also
            been building my own tools (Speakeazy, FORGE, and a few smaller ones), by myself, with AI.
            I write here occasionally. I live in Dallas, and yes, I still open Figma
            and a code editor every week.
          </p>
          <a class="more" href="/about">More about me</a>
        </div>
      </div>
    </section>

    <!-- 05 CTA — the color field -->
    <section class="cta">
      <div class="container">
        <div class="sec-head"><span class="no">05</span><h2 class="ttl">Contact</h2></div>
        <h2>That's the pitch. Here's how to reach me.</h2>
        <a class="email" href="mailto:brandon@uxward.com">
          <svg class="send-ico" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g class="send-icon"><path d="M10 14l11 -11" /><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></g></svg>
          <span class="email-text">brandon@uxward.com</span>
        </a>
        <p class="note">It goes straight to me. I read it every day.</p>
      </div>
    </section>
  </div>

  <script>
    // Hero backdrop video: load + play only in cyber mode so non-cyber visitors never fetch the clip.
    (function () {
      var root = document.documentElement;
      var video = document.querySelector('.hero-bg-video');
      if (!video) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      function sync() {
        var on = root.classList.contains('cyber') && !reduce.matches;
        if (on) {
          if (!video.src) video.src = video.dataset.src;
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        } else {
          video.pause();
        }
      }
      new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['class'] });
      reduce.addEventListener('change', sync);
      sync();
    })();
  </script>
</Base>
