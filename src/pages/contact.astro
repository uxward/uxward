---
import Base from '../layouts/Base.astro';

const faq = [
  {
    q: "What tier do you work at?",
    a: `Happy at Precocity, but always willing to chat. Head of Design, VP of Design, Chief Design Officer,
            Chief Experience Officer. <em>Executive roles, in other words.</em> Not interested in IC work (unless you're
            LEGO or a major streaming service), management below Director, or contract work outside what Precocity already does.`
  },
  {
    q: "Where do you work from?",
    a: `Dallas (where I live), hybrid with travel, or fully remote. Relocation is on the table for the right leadership role, international included. I will not relocate for a fast-growth startup whose
            runway is the recruiter's main selling point.`
  },
  {
    q: "What makes a company worth the conversation?",
    a: `Design has earned a real seat, and the CEO can name three things their best designer
            shipped last quarter. Flagship consumer and tooling companies clear that bar —
            LEGO, Netflix, Apple, Airbnb and their equivalents — and so do traditionally
            "non-tech" operators like John Deere, Caterpillar, and Maersk.`
  },
  {
    q: "Will you do a take-home?",
    a: `<em>No.</em> The work on this site is the take-home. I will do a paid, time-boxed
            advisory engagement at any stage of the process if it helps both sides decide.`
  },
  {
    q: "Do you speak, write, or advise on the side?",
    a: `I speak now and then, when it's the right room. I write here and on Precocity's blog. I advise
            by introduction. I won't come on your podcast unless you've actually read something here first.`
  }
];

function stripHtml(s) { return s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(); }

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {"@type": "Answer", "text": stripHtml(item.a)}
  }))
};
---
<Base title="Contact — uxward" description="How to reach Brandon E. B. Ward — executive design leader, CXO at Precocity, founder of Speakeazy. Email, read daily." schema={schema}>
  <style>
    /* contact — Archivo / Swiss system. Quieter caps labels; red bleed kept. */

    .name-eyebrow, .section-eyebrow { font-weight: 700; font-size: var(--fs-13); letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink); margin-bottom: var(--space-7); }

    .name-block { padding-top: var(--space-9); padding-bottom: var(--space-9); }
    h1.name { font-weight: 900; font-size: var(--fs-d6); line-height: 0.98; letter-spacing: -0.035em; word-spacing: 0.06em; text-wrap: balance; color: var(--ink); margin: 0; max-width: 18ch; }
    h1.name em { font-style: normal; }
    .deck { font-weight: 400; font-size: var(--fs-lede); line-height: 1.5; color: var(--body); margin: var(--space-7) 0 0; max-width: 64ch; }

    /* Red bleed CTA */
    .bleed { background: var(--signature-field); color: var(--offwhite); padding: 120px 0 112px; }
    .bleed .eyebrow { font-weight: 600; font-size: var(--fs-12); letter-spacing: 0.05em; text-transform: uppercase; color: var(--offwhite); margin-bottom: var(--space-8); }
    .bleed h2 { font-weight: 900; font-size: var(--fs-d6); line-height: 0.98; letter-spacing: -0.035em; word-spacing: 0.06em; text-wrap: balance; color: var(--offwhite); margin: 0; max-width: 18ch; }
    .bleed h2 em { font-style: normal; }
    .bleed a.email { margin-top: var(--space-9); display: inline-flex; align-items: center; gap: 0.45em; font-weight: 800; font-size: var(--fs-d2); line-height: 1.1; letter-spacing: -0.02em; color: var(--offwhite); }
    .bleed a.email .email-text { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
    .bleed a.email .send-ico { width: 0.82em; height: 0.82em; }
    .bleed a.email:hover .send-icon,
    .bleed a.email:focus-visible .send-icon { animation: send-fly 0.5s ease; }
    .bleed .kicker { font-weight: 600; font-size: var(--fs-12); letter-spacing: 0.05em; text-transform: uppercase; color: var(--offwhite); margin-top: var(--space-5); }

    .section { padding: var(--space-10) 0; border-top: 1px solid var(--rule-faint); }
    .section-head { font-weight: 900; font-size: var(--fs-d2); line-height: 1.04; letter-spacing: -0.025em; word-spacing: 0.04em; text-wrap: balance; color: var(--ink); margin: 0 0 var(--space-8) 0; max-width: 22ch; }
    .section-head em { font-style: normal; }

    .channels, .elsewhere-list, .faq { border-top: 1px solid var(--rule-faint); }
    .channel-row { display: grid; grid-template-columns: 200px 1fr 200px; gap: var(--space-7); padding: var(--space-5) 0; border-bottom: 1px solid var(--rule-faint); align-items: baseline; }
    .channel-row .where { font-weight: 600; font-size: var(--fs-11); letter-spacing: 0.05em; text-transform: uppercase; color: var(--tertiary); }
    .channel-row .what { font-size: var(--fs-16); line-height: 1.55; color: var(--body); }
    .channel-row a.go { font-weight: 700; font-size: var(--fs-14); color: var(--ink); text-decoration: none; text-align: right; }
    @media (hover: hover) { .channel-row a.go:hover { color: var(--signature); } }

    .elsewhere-row { display: grid; grid-template-columns: 140px 1fr max-content; gap: var(--space-7); padding: var(--space-5) 0; border-bottom: 1px solid var(--rule-faint); align-items: baseline; }
    .elsewhere-row .where { font-weight: 600; font-size: var(--fs-11); letter-spacing: 0.05em; text-transform: uppercase; color: var(--tertiary); }
    .elsewhere-row .what { font-size: var(--fs-18); line-height: 1.5; color: var(--body); }
    .elsewhere-row a.go { font-weight: 700; font-size: var(--fs-14); color: var(--ink); text-decoration: none; text-align: right; white-space: nowrap; }
    @media (hover: hover) { .elsewhere-row a.go:hover { color: var(--signature); } }

    .faq-row { display: grid; grid-template-columns: 280px 1fr; gap: var(--space-8); padding: var(--space-7) 0; border-bottom: 1px solid var(--rule-faint); align-items: baseline; }
    .faq-row .q { font-weight: 700; font-size: var(--fs-18); line-height: 1.3; color: var(--ink); }
    .faq-row .a { font-size: var(--fs-18); line-height: 1.6; color: var(--body); max-width: 580px; }
    .faq-row .a em { font-style: italic; }

    .note p { font-size: var(--fs-16); line-height: 1.6; color: var(--body); max-width: 580px; margin: 0; }
    .note .stamp { font-weight: 600; font-size: var(--fs-11); letter-spacing: 0.05em; text-transform: uppercase; color: var(--tertiary); margin-top: var(--space-6); }

    @media (max-width: 900px) {
      .channel-row { grid-template-columns: 1fr; }
      .channel-row a.go { text-align: left; }
      .elsewhere-row { grid-template-columns: 1fr; }
      .elsewhere-row a.go { text-align: left; }
      .faq-row { grid-template-columns: 1fr; }
    }
  </style>

  <div class="container name-block">
    <div class="name-eyebrow">Contact</div>
    <h1 class="name">How to <em>reach me</em>, and a few things worth knowing first.</h1>
    <p class="deck">
      Most of this page is for recruiters, hiring managers, and reporters. If you just read
      something here and want to say hi, skip all of it and write. Short is fine.
    </p>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-eyebrow">Other channels</div>
      <h2 class="section-head">Email works best. <em>The rest exist, but they're slower.</em></h2>
      <div class="elsewhere-list">
        <div class="elsewhere-row">
          <span class="where">LinkedIn</span>
          <span class="what">The résumé version. Connection requests are welcome.</span>
          <a class="go" href="https://linkedin.com/in/brandonebward" target="_blank" rel="noopener">/in/brandonebward</a>
        </div>
        <div class="elsewhere-row">
          <span class="where">GitHub</span>
          <span class="what">The code for this site. Everything else I've built lives in private repos.</span>
          <a class="go" href="https://github.com/uxward" target="_blank" rel="noopener">/uxward</a>
        </div>
        <div class="elsewhere-row">
          <span class="where">Calendar</span>
          <span class="what">I don't post a booking link. Email me and I'll send one.</span>
          <a class="go" href="mailto:brandon@uxward.com">brandon@uxward.com</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-eyebrow">Before you write</div>
      <h2 class="section-head">The questions I get most, answered, <em>so you don't have to ask.</em></h2>
      <div class="faq">
        {faq.map(item => (
          <div class="faq-row">
            <div class="q">{item.q}</div>
            <div class="a" set:html={item.a}></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section note">
    <div class="container">
      <div class="section-eyebrow">A note on response</div>
      <p>
        I read every email that lands here and reply within two business days, even when the
        answer is no. If a week goes by with nothing, it didn't arrive. Send it again.
      </p>
      <div class="stamp">Last revised Q2 2026 · Updated occasionally</div>
    </div>
  </section>

  <section class="bleed">
    <div class="container">
      <div class="eyebrow">The email</div>
      <h2>Okay. <em>Here's the email.</em></h2>
      <a class="email" href="mailto:brandon@uxward.com">
        <svg class="send-ico" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g class="send-icon"><path d="M10 14l11 -11" /><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></g></svg>
        <span class="email-text">brandon@uxward.com</span>
      </a>
      <div class="kicker">Read daily · Reply within two business days</div>
    </div>
  </section>
</Base>
